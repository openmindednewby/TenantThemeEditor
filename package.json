{
  "name": "tenant-theme-editor",
  "version": "0.1.0",
  "description": "A standalone tenant theme editor micro-frontend for SaaS white-label customization",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "vite",
    "typescript",
    "tailwindcss",
    "theme-editor",
    "white-label",
    "tenant-customization"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "api:generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.2.7",
    "@fontsource/inter": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.7",
    "@tanstack/react-query": "^5.51.0",
    "axios": "^1.6.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.0.0",
    "jsdom": "^28.0.0",
    "orval": "^8.2.0",
    "postcss": "^8.4.0",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
